{
  "schema_version": "1.1",
  "game_id": "five_word_story",
  "game_name": "五詞故事卡 · 故事接龍",
  "description": "三種模式：五詞造句、五詞故事、故事接龍。每棒從人物/地點/物品/動作/轉折各抽1張；接龍模式A/B輪流延續上一棒的情節。",
  "categories": [
    "人物",
    "地點",
    "物品",
    "動作",
    "轉折"
  ],
  "themes": [
    "甜蜜",
    "搞笑",
    "奇幻",
    "混搭"
  ],
  "modes": {
    "sentence": {
      "title": "五詞造句",
      "recommended_seconds": 60,
      "rule": "用抽到的5個詞造一個完整句子，可自由調整詞序。"
    },
    "story": {
      "title": "五詞故事",
      "recommended_seconds": 180,
      "rule": "把5個詞串成有開頭、發展與結尾的故事，可口述或輸入。"
    },
    "relay": {
      "title": "故事接龍",
      "recommended_seconds_per_turn": 120,
      "default_turns": 4,
      "allowed_turns": [
        4,
        6,
        8
      ],
      "rule": "玩家A先起頭，每棒抽全新5張卡；下一位玩家必須接續此前故事，不可另起爐灶；最後一棒為故事結尾。全詞使用判定按本棒抽到的新卡，上一棒卡牌不算本棒任務。"
    }
  },
  "answer_policy": {
    "correct_answer": null,
    "require_all_five_words": true,
    "allowed_order": "any",
    "text_check": "contains each exact drawn word as substring; only a completeness aid, not a creativity score",
    "oral_mode": "partner manually confirms use of all five words",
    "judge": "partner gives 0, 3 or 5 bonus points; creativity must not be automatically judged"
  },
  "score_policy": {
    "all_five_words_points": 10,
    "partner_bonus_options": [
      0,
      3,
      5
    ],
    "max_points_per_round": 15
  },
