# Put these ONLY in Netlify Project configuration -> Environment variables (scope Functions)
# See Supabase dashboard -> Connect / Settings -> API Keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY
# Optional: OpenAI Platform key for Functions. Apply the V4 AI usage migration first.
OPENAI_API_KEY=
# Responses API model supporting Structured Outputs for couple and riddle topics.
OPENAI_MODEL=gpt-4.1-mini
# Responses API model supporting Structured Outputs and web_search for factual topics.
OPENAI_NEWS_MODEL=gpt-4.1
