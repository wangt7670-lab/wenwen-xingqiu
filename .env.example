# Put these ONLY in Netlify Project configuration -> Environment variables (scope Functions)
# See Supabase dashboard -> Connect / Settings -> API Keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY
# Deploy Previews stay offline until these are set for an isolated database.
PRODUCTION_SUPABASE_HOST=
PREVIEW_SUPABASE_URL=
PREVIEW_SUPABASE_SECRET_KEY=
# Enable only after verifying the optional WebGPU model on your target device.
ENABLE_LOCAL_AI=false
